{
  "include": ["env.d.ts", "src/**/*", "e2e-queue/admin-entry.tsx"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The oldest browser a guest's phone may bring is Safari 15.4 (iOS 15, the last release for
    // the iPhone 6s and 7), which has ES2022 and none of ES2023's copying array methods
    // (`toSorted`, `toReversed`, `with`). The bundler lowers syntax for it (`build.target` in
    // `vite.config.ts`) but adds no polyfills, so this is what keeps a newer method from
    // type-checking here and then crashing on that phone. `ESNext.Disposable` is only for the
    // stores' `[Symbol.dispose]()` methods: Safari has no `Symbol.dispose`, so there the method is
    // keyed `"undefined"`, which still works because every caller looks it up the same way.
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": [],

    // Vite compiles each module on its own and never reads types, so emit is TypeScript's only
    // job here: `tsc --build` type-checks and writes declarations, nothing more.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./node_modules/.tmp/types",

    "strict": true,
    // This codebase writes explicit `.ts`/`.tsx` extensions on relative imports, which Vite
    // resolves directly. Emit is declarations-only, so TypeScript allows it.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"]
    },

    // `tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
