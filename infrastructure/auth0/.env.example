# Copy to .env.source for export, or .env.target for import (both are gitignored).
# Use a dedicated Machine to Machine application authorized for the Auth0 Management API.
# These are NOT the VITE_AUTH0_* browser application settings.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-deploy-cli-client-id
AUTH0_CLIENT_SECRET=your-deploy-cli-client-secret
AUTH0_ALLOW_DELETE=false
AUTH0_EXPORT_IDENTIFIERS=false

# For portable placeholders in the reviewed configuration, supply mappings as JSON:
# AUTH0_KEYWORD_REPLACE_MAPPINGS='{"APP_ORIGIN":"https://your-site.example"}'
