# Copy to metabase/.env and set a real password before running `npm run metabase:up`.
# This only protects Metabase's own app database (dashboards, saved questions, Metabase user
# accounts) — it is unrelated to the app's guest data. Do not commit metabase/.env.
METABASE_DB_PASSWORD=change-me

# Only needed if you run the optional `cloudflared` service (docker compose --profile tunnel up)
# to expose Metabase at a public https URL. Get this token from the Cloudflare Zero Trust
# dashboard: Networks → Tunnels → create a tunnel → the token is shown in its install command.
CLOUDFLARE_TUNNEL_TOKEN=change-me
