VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
VITE_AUTH0_ISSUER=https://your-tenant.us.auth0.com/
# Required: the app refuses to start without it, and a Netlify build fails. To run with every flag
# at its default and no network calls instead, leave it out and set VITE_LAUNCHDARKLY_DISABLED=true
# (refused on Netlify).
VITE_LAUNCHDARKLY_CLIENT_ID=your-launchdarkly-client-side-id
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-contact@example.org
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
# Signs the codes and tokens that unlock a /kiosk room display; at least 32 characters, e.g. the
# output of `openssl rand -base64 32`. Changing it relocks every display. See docs/roles.md.
KIOSK_SECRET=replace-with-at-least-32-random-characters
NOTIFICATIONS_ENABLED=true
LOG_LEVEL=info
SMS_LOG_FILE=logs/sms.log
SENTRY_DSN=https://examplePublicKey@o0.ingest.us.sentry.io/0
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.us.sentry.io/0

# Server-only dedicated M2M credentials for staff management (never VITE_ variables).
AUTH0_MANAGEMENT_DOMAIN=
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
AUTH0_WORKER_CONNECTION=Username-Password-Authentication
