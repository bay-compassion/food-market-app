{
  "name": "bay-compassion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS='--inspect' npx netlify dev",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "checks": "node scripts/checks.js",
    "check:translations": "node scripts/check-translations.js",
    "check:diagrams": "node scripts/check-diagrams.js",
    "netlify:prune-deploys": "node scripts/prune-netlify-deploys.js"
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.8.0",
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "jose": "^6.2.3",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "del-cli": "^7.0.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
