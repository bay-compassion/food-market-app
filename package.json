{
  "name": "bay-compassion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS='--inspect' npx netlify dev",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "test:unit": "vitest",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "checks": "node scripts/checks.js",
    "capture:twilio": "tsx scripts/capture-twilio-opt-in.mts",
    "seed": "tsx scripts/seed-fake-data.mts",
    "check:translations": "node scripts/check-translations.js",
    "check:diagrams": "node scripts/check-diagrams.js",
    "netlify:prune-deploys": "node scripts/prune-netlify-deploys.js",
    "metabase:up": "docker compose -f metabase/docker-compose.yml up -d",
    "metabase:down": "docker compose -f metabase/docker-compose.yml down"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.1",
    "@base-ui/react": "^1.7.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "@netlify/vite-plugin": "^2.12.9",
    "drizzle-orm": "^1.0.0-beta.22",
    "hono": "^4.13.5",
    "jose": "^6.2.3",
    "marked": "^18.0.9",
    "mobx": "^6.16.1",
    "outdent": "^0.8.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "reflect-metadata": "^0.2.2",
    "twilio": "^6.1.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/react-vite": "^10.5.10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "del-cli": "^7.0.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "jsdom": "^29.1.1",
    "mobx-react-lite": "^4.1.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.8",
    "tsx": "^4.22.3",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
