// The frame apps: the guest phone (`phone/`) and the admin dashboard (`admin/`), small React apps
// around the app's own screens, which Vite builds for the guest and admin guides. Checked like the
// app itself, which they import.
{
  "include": [
    "phone/**/*.ts",
    "phone/**/*.tsx",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "stage/frame.ts"
  ],
  "exclude": ["phone/vite.config.ts", "admin/vite.config.ts"],

  "references": [{ "path": "../../tsconfig.app.json" }],

  "compilerOptions": {
    "composite": true,
    "noEmit": true,

    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // `vite/client` for the stylesheet imports in `main.tsx`.
    "types": ["vite/client"],

    // The app's own modules import each other through `@/`, which Vite resolves the same way.
    "paths": { "@/*": ["../../src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.presentations-phone.tsbuildinfo"
  }
}
