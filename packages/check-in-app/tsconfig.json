// The main process and preload (`src/`, bundled by electron-vite) and the Node scripts beside it
// (`package.ts`, the electron-vite config), which Node runs by stripping their types. Both use only
// erasable syntax and import with real `.ts` extensions. Referenced from the repository root, so
// `pnpm run type-check` and oxlint's type-aware pass cover it.
{
  "extends": "@tsconfig/node24/tsconfig.json",

  "include": ["*.ts", "src/**/*.ts"],

  "compilerOptions": {
    "composite": true,
    "noEmit": true,

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // `electron-vite/node` declares the `?asset` imports electron-vite resolves.
    "types": ["node", "electron-vite/node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.check-in-app.tsbuildinfo"
  }
}
