// TSConfig for modules that run in Node.js environment via either transpilation or type-stripping.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "vitest.unit.config.*",
    "cypress.config.*",
    "playwright.config.*",
    "playwright.queue.config.ts",
    "e2e-queue/**/*.ts",
    "e2e-queue/**/*.mts",
    "eslint.config.*",
    "scripts/capture-twilio-opt-in.mts",
    "scripts/generate-brand-assets.mts",
    "scripts/screenshots/**/*.mts",
    "scripts/smoke-test-sms.mts",
    "infrastructure/auth0/auth0.mts",
    "scripts/inspect-twilio-campaign.mts",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    // Most tools use transpilation instead of Node.js's native type-stripping.
    // Bundler mode provides a smoother developer experience.
    "module": "preserve",
    "moduleResolution": "bundler",
    // `e2e-queue/` reaches `src/locales.ts` and the models it imports, which name their siblings
    // `./x.ts` so the presentations can run them under plain Node, as `tsconfig.app.json` allows.
    "allowImportingTsExtensions": true,

    // Include Node.js types and avoid accidentally including other `@types/*` packages.
    "types": ["node"],

    // Disable emitting output during `tsc --build`, which is used for type-checking only.
    "noEmit": true,

    // `tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
